# RustFlow-AI Configuration

# Logging
RUST_LOG=info,rustflow_ai=debug
LOG_FORMAT=json

# Controller
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=6653
OPENFLOW_VERSION=1.3

# Dashboard API
API_HOST=0.0.0.0
API_PORT=8080

# Monitoring
EBPF_ENABLED=false
MONITORING_INTERVAL_MS=1000

# ML Engine
ML_MODEL_PATH=/models/traffic_predictor.onnx
ML_INFERENCE_THREADS=4
ML_BATCH_SIZE=32

# Optimizer
OPTIMIZER_ALGORITHM=shortest_path
REBALANCE_THRESHOLD=0.8
REROUTE_DELAY_MS=500

# Resilience
FAILURE_DETECTION_TIMEOUT_MS=3000
BACKUP_PATH_COUNT=2
AUTO_RECOVERY_ENABLED=true

# Metrics
PROMETHEUS_PORT=9090
METRICS_EXPORT_INTERVAL_MS=5000

# Database (future)
DATABASE_URL=postgresql://localhost/rustflow

# Redis (future)
REDIS_URL=redis://localhost:6379
