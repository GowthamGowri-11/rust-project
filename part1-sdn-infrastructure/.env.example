# RustFlow-AI Controller Configuration

# Logging
RUST_LOG=info,controller=debug,network_core=debug
LOG_FORMAT=json

# Controller
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=6653
OPENFLOW_VERSION=1.0

# Timeouts
CONNECTION_TIMEOUT_MS=5000
ECHO_INTERVAL_MS=10000

# Performance
MAX_CONNECTIONS=100
BUFFER_SIZE=4096
